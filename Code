    pageContent.innerHTML='<div class="page-intro-row"><p class="page-intro">Keep subscriptions and recurring bills visible before they surprise you. Marking a bill paid adds an expense to the ledger.</p><span class="pill">'+recurringBills.length+' scheduled items</span></div>'+
      '<section class="bill-summary-grid"><article class="stat featured"><div class="stat-top"><span>Upcoming total</span><span class="stat-icon">↻</span></div><div class="stat-value">'+inr(dueTotal)+'</div><div class="stat-foot">Bills not marked paid</div></article><article class="stat"><div class="stat-top"><span>Upcoming bills</span><span class="stat-icon">◷</span></div><div class="stat-value">'+unpaid.length+'</div><div class="stat-foot">Need your attention</div></article><article class="stat"><div class="stat-top"><span>Marked paid</span><span class="stat-icon">✓</span></div><div class="stat-value">'+recurringBills.filter(b=>b.paid).length+'</div><div class="stat-foot">In this demo workspace</div></article></section>'+
      '<section class="two-col recurring-layout"><article class="panel"><div class="panel-head"><div><div class="mini-label">SCHEDULE A PAYMENT</div><h3>Add recurring bill</h3></div><span class="stat-icon">＋</span></div><p class="panel-copy">Track rent, subscriptions, utilities or any payment that repeats. This does not send real payments.</p><form id="billForm" class="form-stack"><label class="field">Bill or subscription<input name="title" maxlength="100" placeholder="e.g. Wi-Fi plan" required></label><label class="field">Amount (₹)<input name="amount" type="number" min="0.01" step="0.01" placeholder="799" required></label><label class="field">Category<select name="category"><option>Bills & Utilities</option><option>Entertainment</option><option>Home</option><option>Health</option><option>Transport</option><option>Other</option></select></label><label class="field">Next due date<input name="due" type="date" value="2026-10-28" required></label><label class="field">Frequency<select name="frequency"><option>Weekly</option><option selected>Monthly</option><option>Yearly</option></select></label><button class="btn btn-primary" type="submit"><span class="plus">＋</span> Add recurring bill</button></form><div class="help-tip"><b>Reminder</b><span>This preview tracks due dates only. It will not charge a card or contact a bank.</span></div></article>'+
      '<article class="panel"><div class="panel-head"><div><div class="mini-label">PAYMENT CALENDAR</div><h3>Your recurring commitments</h3></div><span class="pill">'+recurringBills.length+' items</span></div><div class="bill-list">'+(recurringBills.length?recurringBills.slice().sort((a,b)=>a.due.localeCompare(b.due)).map(b=>'<div class="bill-row"><span class="bill-icon">↻</span><div class="bill-detail"><b>'+escapeHtml(b.title)+'</b><span>'+escapeHtml(b.category)+' · '+escapeHtml(b.frequency)+' · due '+prettyDate(b.due)+'</span></div><strong class="bill-money">'+inr(b.amount)+'</strong><span class="bill-status '+(b.paid?'paid':'due')+'">'+(b.paid?'PAID':'UPCOMING')+'</span><div class="bill-actions"><button class="btn btn-soft" type="button" data-bill-toggle="'+b.id+'">'+(b.paid?'Undo paid':'✓ Mark paid')+'</button><button class="text-link" type="button" data-bill-delete="'+b.id+'" aria-label="Delete '+escapeHtml(b.title)+'">Delete</button></div></div>').join(''):'<div class="empty-state"><div class="empty-orb">↻</div><h3>No recurring bills yet</h3><p>Add a regular payment using the form.</p></div>')+'</div></article></section>';
    document.getElementById('billForm').addEventListener('submit',e=>{e.preventDefault();const d=new FormData(e.currentTarget);const title=String(d.get('title')||'').trim();const amount=Number(d.get('amount'));const due=String(d.get('due')||'');if(!title||!Number.isFinite(amount)||amount<=0||!due)return notify('Enter a name, valid amount and due date.');recurringBills.push({id:nextBillId++,title,amount,category:String(d.get('category')),due,frequency:String(d.get('frequency')),paid:false,postedTxnId:null});recurringPage();notify('Recurring bill added.');});
  }
  function toggleBill(id){
    const bill=recurringBills.find(b=>b.id===id);
    if(!bill)return;
    if(!bill.paid){bill.paid=true;const txn={id:nextId++,title:bill.title,category:bill.category,kind:'expense',amount:bill.amount,date:bill.due,note:'Recurring bill marked paid'};transactions.push(txn);bill.postedTxnId=txn.id;notify(bill.title+' marked paid and added to transactions.');}
    else{bill.paid=false;if(bill.postedTxnId){const index=transactions.findIndex(t=>t.id===bill.postedTxnId);if(index>=0)transactions.splice(index,1);}bill.postedTxnId=null;notify(bill.title+' payment mark undone.');}
    recurringPage();
  }
  function deleteBill(id){
    const index=recurringBills.findIndex(b=>b.id===id);
    if(index<0)return;
    const bill=recurringBills[index];
    if(bill.postedTxnId){const txIndex=transactions.findIndex(t=>t.id===bill.postedTxnId);if(txIndex>=0)transactions.splice(txIndex,1);}
    recurringBills.splice(index,1);recurringPage();notify('Recurring bill removed.');
  }
  function exportTransactionsCsv(){
    const cell=value=>'"'+String(value??'').replace(/"/g,'""')+'"';
    const rows=[['Date','Type','Description','Category','Amount INR','Note'],...transactions.map(t=>[t.date,t.kind,t.title,t.category,t.amount,t.note||''])];
    const csv=rows.map(row=>row.map(cell).join(',')).join('\r\n');
    const blob=new Blob([csv],{type:'text/csv;charset=utf-8;'});
    const url=URL.createObjectURL(blob);const link=document.createElement('a');link.href=url;link.download='moneywise-transactions.csv';document.body.appendChild(link);link.click();link.remove();URL.revokeObjectURL(url);notify('Transaction CSV exported.');
  }
  function insightsPage(){
    const spending={}; thisMonth().filter(t=>t.kind==='expense').forEach(t=>spending[t.category]=(spending[t.category]||0)+t.amount);
    const high=Object.entries(spending).sort((a,b)=>b[1]-a[1]).slice(0,4);
    let cards=high.map(([category,amount],i)=>({tone:i===0?'amber':i===1?'green':'blue',icon:i===0?'⌁':i===1?'↘':'✳',kicker:i===0?'SPENDING SNAPSHOT':i===1?'GOOD TO NOTICE':'YOUR MONEY PATTERN',title:`${category} has ${inr(amount)} logged`,body:`You've recorded ${inr(amount)} in ${category} this month. Consider whether that fits what matters to you, and set a budget if a limit would help.`}));
    if(!cards.length) cards=[{tone:'blue',icon:'✳',kicker:'YOUR FIRST INSIGHT',title:'Your money story starts here',body:'Log a few transactions and we can turn your records into useful, explainable spending summaries.'}];
    pageContent.innerHTML=`<section class="insights-hero"><div><span class="goal-tag">✳ YOUR MONEY, DECODED</span><h2>Better questions.<br><em>Calmer decisions.</em></h2><p>Simple observations from entries in this demo. These are prompts for reflection, not verdicts about your choices.</p></div><div class="insight-ring"><div class="insight-ring-inner"><strong>${inr(expense())}</strong><small>SPENT THIS MONTH</small></div></div></section><div class="section-head"><div><div class="mini-label">PERSONAL PATTERNS</div><h3>What your money is telling you</h3></div><span class="pill">${currentMonth}</span></div><section class="insight-grid">${cards.map(c=>`<article class="insight-card"><div class="insight-kicker"><span class="insight-symbol">${c.icon}</span>${c.kicker}</div><h3>${c.title}</h3><p>${c.body}</p></article>`).join('')}</section><div class="notice"><span>ⓘ</span><p><b>Context matters.</b> A higher number isn't automatically bad, and a lower one isn't automatically good. This screen uses only the demo transactions and doesn't know your full situation.</p></div>`;
  }
  function renderPage(page=currentPage){
    currentPage=page;
    document.querySelectorAll('.nav-button').forEach(b=>b.classList.toggle('active',b.dataset.page===page));
    const titles={overview:'Good money habits start here. <span class="heading-spark">✳</span>',transactions:'Every rupee has a story.',budgets:'Give your money a plan.',goals:'Make room for what matters.',analytics:'Your money, in motion.',recurring:'Stay ahead of recurring bills.'};
    pageTitle.innerHTML=titles[page]||titles.overview;
    if(page==='overview')overview(); if(page==='transactions')transactionPage(); if(page==='budgets')budgetPage(); if(page==='goals')goalsPage(); if(page==='analytics')analyticsPage(); if(page==='recurring')recurringPage();
    window.scrollTo({top:0,behavior:'smooth'});
  }
  function openModal(){modal.classList.add('open');setTimeout(()=>form.elements.title.focus(),30);}
  function closeModal(){modal.classList.remove('open');form.reset();form.elements.txn_date.value='2026-10-24';}
  function addFromForm(activeForm){
    const d=new FormData(activeForm), title=String(d.get('title')||'').trim(), amount=Number(d.get('amount')), kind=String(d.get('kind')), category=String(d.get('category')), date=String(d.get('txn_date'));
    if(!title||!Number.isFinite(amount)||amount<=0||!date){notify('Add a description, valid amount, and date.');return;}
    transactions.push({id:nextId++,title,amount,kind,category,date,note:String(d.get('note')||'').trim()});
    closeModal();renderPage(currentPage);notify('Transaction added to this preview session.');
  }
  document.querySelectorAll('.nav-button').forEach(b=>b.addEventListener('click',()=>renderPage(b.dataset.page)));
  document.getElementById('openAdd').addEventListener('click',openModal);
  document.getElementById('closeModal').addEventListener('click',closeModal);
  document.getElementById('cancelModal').addEventListener('click',closeModal);
  modal.addEventListener('click',e=>{if(e.target===modal)closeModal();});
  document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal();});
  form.addEventListener('submit',e=>{e.preventDefault();addFromForm(form);});
  pageContent.addEventListener('click',e=>{const exportButton=e.target.closest('[data-export="csv"]');if(exportButton){exportTransactionsCsv();return;}const toggle=e.target.closest('[data-bill-toggle]');if(toggle){toggleBill(Number(toggle.dataset.billToggle));return;}const removeBill=e.target.closest('[data-bill-delete]');if(removeBill){deleteBill(Number(removeBill.dataset.billDelete));return;}const goalAdd=e.target.closest('[data-goal-add]');if(goalAdd){const goal=goals[Number(goalAdd.dataset.goalAdd)];if(!goal)return;if(goal.saved>=goal.target){notify('This goal is already fully funded.');return;}goal.saved=Math.min(goal.target,goal.saved+500);renderPage('goals');notify('₹500 added to '+goal.title+'.');return;}const b=e.target.closest('[data-go]');if(b)renderPage(b.dataset.go);});
  renderPage('overview');
})();
</script>
</body>
</html>
